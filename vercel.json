{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/jobs",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/app/api/realtime/route.ts": { "maxDuration": 60 },
    "src/app/api/webhooks/whatsapp/route.ts": { "maxDuration": 30 },
    "src/app/api/jobs/route.ts": { "maxDuration": 60 }
  }
}
