# =====================================================================
# PRICALL — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) ou configure no painel do
# provedor de hospedagem (homologação/produção).
#
# NUNCA versione o arquivo preenchido. Nenhum destes valores é exposto
# ao navegador: todos são lidos apenas no servidor.
# =====================================================================

# ---------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------
APP_NAME=PRICALL
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------
# Banco de dados
#
# `pglite`   → Postgres embutido em WASM, gravado em disco. Roda tudo,
#              inclusive o modo demonstração, sem serviço externo.
#              Use apenas em desenvolvimento.
# `postgres` → Postgres/Supabase real. Obrigatório em produção.
# ---------------------------------------------------------------------
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.pgdata
# DATABASE_URL=postgres://usuario:senha@host:6543/pricall?sslmode=require
#
# Conexão DIRETA (sem pooler), usada pelo LISTEN/NOTIFY do tempo real.
# Pooler em modo transação — Supabase 6543, Neon "pooled" — descarta a
# subscrição. Sem esta variável o tempo real fica restrito a uma instância.
# DATABASE_URL_UNPOOLED=postgres://usuario:senha@host:5432/pricall?sslmode=require

# ---------------------------------------------------------------------
# Sessão e autenticação
# Gere com: openssl rand -base64 48
# ---------------------------------------------------------------------
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------
# WhatsApp Business Platform — Cloud API (Meta)
#
# No cadastro da conexão, informe a REFERÊNCIA ao segredo
# (ex.: `env:WHATSAPP_ACCESS_TOKEN`), nunca o token em si.
# ---------------------------------------------------------------------
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------
# Evolution API
# ---------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------
# Inteligência artificial (assistiva, sempre com revisão humana)
# `mock` funciona sem chave e sem chamada externa.
# ---------------------------------------------------------------------
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=700

# ---------------------------------------------------------------------
# E-mail transacional
#
# `log`    — imprime no servidor, não envia nada (padrão em desenvolvimento)
# `smtp`   — qualquer servidor SMTP, inclusive Gmail com Senha de App
# `resend` — API do Resend, para volume maior
# ---------------------------------------------------------------------
MAIL_PROVIDER=log
MAIL_FROM=PRICALL <nao-responda@suaempresa.com.br>
MAIL_REPLY_TO=

# Gmail: crie uma Senha de App em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada). Não use a senha da conta.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# Alternativa ao SMTP
RESEND_API_KEY=

# ---------------------------------------------------------------------
# Tarefas periódicas
#
# Aceita `x-pricall-job-token: $JOB_TOKEN` (cron externo) ou
# `Authorization: Bearer $CRON_SECRET` (formato do Vercel Cron).
# ---------------------------------------------------------------------
JOB_TOKEN=
CRON_SECRET=

# ---------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------
# Demonstração
# ---------------------------------------------------------------------
DEMO_MODE_ENABLED=true
